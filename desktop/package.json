{
  "name": "planet-escape-desktop",
  "productName": "Planet Escape",
  "version": "0.1.0",
  "description": "Planet Escape \u2013 a sci-fi factory-building game",
  "main": "main.cjs",
  "private": true,
  "author": "Planet Escape",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "build": {
    "appId": "dev.planetescape.game",
    "productName": "Planet Escape",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "extraResources": [
      {
        "from": "steam",
        "to": ".",
        "filter": [
          "steam_appid.txt"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Planet Escape"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "executableName": "planet-escape"
    },
    "artifactName": "Planet-Escape-${version}-${os}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcelWeissgerberIT/PlanetEscape.git"
  }
}
