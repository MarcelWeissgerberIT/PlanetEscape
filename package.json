{
  "name": "planet-escape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Planet Escape \u2013 a bilingual (EN/DE) sci-fi factory-building game. Build production chains to assemble a spaceship and escape the planet.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/process-assets.mjs",
    "mcp:build": "node mcp/build.mjs",
    "mcp:start": "node mcp/dist/index.mjs",
    "mcp:test": "node mcp/test-client.mjs",
    "ray:check": "esbuild tools/ray-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/ray-check.mjs --log-level=warning && node mcp/dist/ray-check.mjs",
    "blocks:check": "esbuild tools/blocks-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/blocks-check.mjs --log-level=warning && node mcp/dist/blocks-check.mjs",
    "examples:check": "esbuild tools/examples-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/examples-check.mjs --log-level=warning && node mcp/dist/examples-check.mjs",
    "trailer:check": "esbuild tools/trailer-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/trailer-check.mjs --log-level=warning && node mcp/dist/trailer-check.mjs",
    "blockshd:check": "esbuild tools/blockshd-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/blockshd-check.mjs --log-level=warning && node mcp/dist/blockshd-check.mjs",
    "contracts:check": "esbuild tools/contracts-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/contracts-check.mjs --log-level=warning && node mcp/dist/contracts-check.mjs",
    "projects:check": "esbuild tools/projects-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/projects-check.mjs --log-level=warning && node mcp/dist/projects-check.mjs",
    "wear:check": "esbuild tools/wear-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/wear-check.mjs --log-level=warning && node mcp/dist/wear-check.mjs",
    "flights:check": "esbuild tools/flights-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/flights-check.mjs --log-level=warning && node mcp/dist/flights-check.mjs",
    "challenges:check": "esbuild tools/challenges-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/challenges-check.mjs --log-level=warning && node mcp/dist/challenges-check.mjs",
    "merger:check": "esbuild tools/merger-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/merger-check.mjs --log-level=warning && node mcp/dist/merger-check.mjs",
    "kits:check": "esbuild tools/kits-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/kits-check.mjs --log-level=warning && node mcp/dist/kits-check.mjs",
    "storage:check": "esbuild tools/storage-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/storage-check.mjs --log-level=warning && node mcp/dist/storage-check.mjs",
    "logistics:check": "esbuild tools/logistics-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/logistics-check.mjs --log-level=warning && node mcp/dist/logistics-check.mjs",
    "parts:check": "esbuild tools/parts-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/parts-check.mjs --log-level=warning && node mcp/dist/parts-check.mjs",
    "kdos:check": "esbuild tools/kdos-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/kdos-check.mjs --log-level=warning && node mcp/dist/kdos-check.mjs",
    "board:check": "esbuild tools/board-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/board-check.mjs --log-level=warning && node mcp/dist/board-check.mjs",
    "solver:check": "esbuild tools/solver-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/solver-check.mjs --log-level=warning && node mcp/dist/solver-check.mjs",
    "save:ttt": "esbuild tools/make-save-ttt.ts --bundle --platform=node --format=esm --outfile=mcp/dist/make-save-ttt.mjs --log-level=warning && node mcp/dist/make-save-ttt.mjs",
    "save:ray": "esbuild tools/make-save-raycaster.ts --bundle --platform=node --format=esm --outfile=mcp/dist/make-save-raycaster.mjs --log-level=warning && node mcp/dist/make-save-raycaster.mjs",
    "save:blocks": "esbuild tools/make-save-blocks.ts --bundle --platform=node --format=esm --outfile=mcp/dist/make-save-blocks.mjs --log-level=warning && node mcp/dist/make-save-blocks.mjs",
    "save:terminal": "esbuild tools/make-save-terminal.ts --bundle --platform=node --format=esm --outfile=mcp/dist/make-save-terminal.mjs --log-level=warning && node mcp/dist/make-save-terminal.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "sharp": "^0.34.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "bin": {
    "planet-escape-mcp": "mcp/dist/index.mjs"
  }
}
