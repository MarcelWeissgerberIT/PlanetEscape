{
  "name": "planet-escape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Planet Escape – a bilingual (EN/DE) sci-fi factory-building game. Build production chains to assemble a spaceship and escape the planet.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/process-assets.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "sharp": "^0.34.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
