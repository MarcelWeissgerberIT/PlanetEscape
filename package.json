{
  "name": "planet-escape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Planet Escape \u2013 a bilingual (EN/DE) sci-fi factory-building game. Build production chains to assemble a spaceship and escape the planet.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/process-assets.mjs",
    "mcp:build": "node mcp/build.mjs",
    "mcp:start": "node mcp/dist/index.mjs",
    "mcp:test": "node mcp/test-client.mjs",
    "board:check": "esbuild tools/board-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/board-check.mjs --log-level=warning && node mcp/dist/board-check.mjs",
    "solver:check": "esbuild tools/solver-check.ts --bundle --platform=node --format=esm --outfile=mcp/dist/solver-check.mjs --log-level=warning && node mcp/dist/solver-check.mjs",
    "save:ttt": "esbuild tools/make-save-ttt.ts --bundle --platform=node --format=esm --outfile=mcp/dist/make-save-ttt.mjs --log-level=warning && node mcp/dist/make-save-ttt.mjs",
    "save:terminal": "esbuild tools/make-save-terminal.ts --bundle --platform=node --format=esm --outfile=mcp/dist/make-save-terminal.mjs --log-level=warning && node mcp/dist/make-save-terminal.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "sharp": "^0.34.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "bin": {
    "planet-escape-mcp": "mcp/dist/index.mjs"
  }
}
